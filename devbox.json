{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": [
    "python310@latest",
    "portaudio@latest",
    "python310Packages.pyaudio@latest",
    "gcc@latest",
    "gpp@latest",
    "python310Packages.pip@latest",
    "zig@0.16.0",
    "zls@0.16.0"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "build":   ["zig build wasm"],
      "serve":   ["python3 -m http.server --directory docs 8080"],
      "dev":     ["zig build wasm && python3 -m http.server --directory docs 8080"],
      "test":    ["zig build test"],
      "test:js": ["node docs/js/editor.test.js"]
    }
  }
}
